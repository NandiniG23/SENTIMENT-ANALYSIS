table History_Open
	lineageTag: 57484d32-1925-4a47-b8fa-d4ea7d275a2a

	measure 'Created(Open File)' = ```
			VAR CurrentDate = SELECTEDVALUE ( _Date_tracker[Date] )
			RETURN
			IF (
			    ISBLANK ( CurrentDate ),
			    BLANK (),
			    CALCULATE (
			        COUNTROWS ( Open_Order ),
			        FILTER (
			            Open_Order,
			            DATEVALUE ( Open_Order[Created Date] ) = CurrentDate
			                && TRIM ( Open_Order[Status] ) IN { "Manage", "Release" }
			                && TRIM ( Open_Order[Delivery Order Owner] )
			                    IN { "Amit VETHEKAR", "Rohan Lokhande", "Akshay CHAPKE", "vaibhav rane" }
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 78a035fb-6338-4336-83bc-3b3f8868d007

	measure 'created (Closed File)' = ```
			VAR CurrentDate = SELECTEDVALUE ( _Date_tracker[Date] )
			RETURN
			IF (
			    ISBLANK ( CurrentDate ),
			    BLANK (),
			    CALCULATE (
			        DISTINCTCOUNT ( Closed_order[Order Reference] ),
			        Closed_order[Created_Date_Only] = CurrentDate
			    )
			)
			```
		formatString: 0
		lineageTag: 221ec0cb-77ca-43b8-a092-6de65274c674

	measure 'Total New Created(Open+Closed)' = [Created(Open File)] + [created (Closed File)]
		formatString: 0
		lineageTag: 6d637e4d-fa7b-477d-8140-b17741203834

	measure 'Acutal closed' = ```
			VAR CurrentDate = SELECTEDVALUE ( _Date_tracker[Date] )
			RETURN
			IF (
			    ISBLANK ( CurrentDate ),
			    BLANK (),
			    CALCULATE (
			        DISTINCTCOUNT ( Closed_order[Order Reference] ),
			        Closed_order[Closed_Date_Only] = CurrentDate
			    )
			)
			```
		formatString: 0
		lineageTag: 8db30f13-ff68-4fd6-b94f-57938213cbb8

	measure 'Move to Billing' = ```
			VAR CurrentDate = SELECTEDVALUE ( _Date_tracker[Date] )
			RETURN
			IF (
			    ISBLANK ( CurrentDate ),
			    BLANK (),
			    CALCULATE (
			        COUNTROWS ( Open_Order ),
			        FILTER (
			            Open_Order,
			            DATEVALUE ( Open_Order[Effective Billing Date] ) = CurrentDate
			                && TRIM ( Open_Order[Status] ) IN { "Acceptance", "Billing", "On-Hold" }
			                && Open_Order[Del Order Coordinator]
			                    IN {
			                        "Amit VETHEKAR",
			                        "Rohan Lokhande",
			                        "vaibhav rane",
			                        "Akshay CHAPKE",
			                        "Ajit Ponkshe"
			                    }
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 73287ab6-75a4-4a00-b79b-2e1f81209c7c

	measure 'Total Closed(Closed+billing)' = [Acutal closed]
		formatString: 0
		lineageTag: 703f58bf-ed28-4f8d-81a8-64e77e3edb7c

	measure 'Running Open' = ```
			VAR CurrentDate = MAX ( _Date_tracker[Date] )
			RETURN
			IF (
			    CurrentDate > TODAY (),
			    0,
			    CALCULATE (
			        [Total New Created(Open+Closed)],
			        FILTER ( ALL ( _Date_tracker[Date] ), _Date_tracker[Date] <= CurrentDate )
			    )
			)
			```
		formatString: 0
		lineageTag: 64259205-3ccf-4a73-8044-d5cbecc045e0

	measure 'Running Total Closed (Closed+billing)' = ```
			VAR CurrentDate = MAX ( _Date_tracker[Date] )
			RETURN
			IF (
			    CurrentDate > TODAY (),
			    0,
			    CALCULATE (
			        [Total Closed(Closed+billing)],
			        FILTER ( ALL ( _Date_tracker[Date] ), _Date_tracker[Date] <= CurrentDate )
			    )
			)
			```
		formatString: 0
		lineageTag: b104d052-89f9-4d0e-a1a6-de4df7f6354d

	measure 'Acutal open' = [Running Open] - [Running Total Closed (Closed+billing)]
		formatString: 0
		lineageTag: ca3451ab-5d94-4eda-b748-7484782085bd

	measure OneOff_Plus_Monthly_EUR_Closed_Factored = ```
			VAR CurrentDate = SELECTEDVALUE ( _Date_tracker[Date] )
			RETURN
			IF (
			    ISBLANK ( CurrentDate ),
			    BLANK (),
			    CALCULATE (
			        SUM ( Closed_order[One Off Total Gold] ),
			        Closed_order[Closed_Date_Only] = CurrentDate
			    )
			)
			```
		formatString: "₹"\ #,0.00;#,0.00\ -"₹";"₹"\ #,0.00
		lineageTag: deac224d-1490-44c5-9058-2a384db4bb3f

		annotation PBI_FormatHint = {"currencyCulture":"bn-IN"}

	measure OneOff_Chgs_EUR_Open_Factored = ```
			VAR CurrentDate = SELECTEDVALUE ( _Date_tracker[Date] )
			RETURN
			IF (
			    ISBLANK ( CurrentDate ),
			    BLANK (),
			    CALCULATE (
			        SUM ( Open_Order[Tot One Off Chgs Eur] )
			            + SUM ( Open_Order[Tot Month Chgs Eur] ),
			        DATEVALUE ( Open_Order[Created Date] ) = CurrentDate
			    ) * 100.351
			)
			```
		formatString: "₹"\ #,0;#,0\ -"₹";"₹"\ #,0
		lineageTag: 46dc660a-334e-41b1-86c8-f7c7d2d0325b

		annotation PBI_FormatHint = {"currencyCulture":"bn-IN"}

	measure 'Total Closed Amt' = SUM ( Closed_order[One Off Total Gold] )
		lineageTag: 518d412e-4ca1-42b5-b4bb-b189bc84260e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total New Created (All)' = [Total New Created(Open+Closed)]
		formatString: 0
		lineageTag: 9b51d1be-56cc-4bfd-b13e-3ce85859185e

	measure 'Current Month Total New Created' = ```
